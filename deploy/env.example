# Copy to .env next to docker-compose.yml and fill in.

# Required: a long random secret for outside access to the model API.
# Generate one with:  openssl rand -hex 32
MODEL_API_KEY=change-me

# ":80" serves plain HTTP on the droplet's IP address.
# Set a domain you point at the droplet (A record) to get HTTPS automatically.
SITE_ADDRESS=:80

# Model. qwen3:1.7b suits a 4 GB / 2 vCPU droplet; qwen3:4b needs 8 GB.
BIOSEQ_MODEL=qwen3:1.7b

# Seconds the app waits for one model reply (CPU servers are slower than laptops).
BIOSEQ_TIMEOUT=300

# To use a model hosted somewhere else instead of the local model service,
# point the app at it (and you can then remove the model services):
# BIOSEQ_BASE_URL=https://other-host.example.com/v1
# BIOSEQ_API_KEY=that-hosts-key
